    <worksheet name='Deprivation and rurality'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>% more than 15 min from a GP</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_data' name='federated.11boon3048arjm1g1m2de1r9jgon' />
          </datasources>
          <datasource-dependencies datasource='federated.11boon3048arjm1g1m2de1r9jgon'>
            <column caption='% over 15 min' datatype='real' default-format='p0.0%' name='[Calculation_0992369569644544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pop_over15]) / SUM([Total_population])' />
            </column>
            <column caption='Total population' datatype='integer' name='[Total_population]' role='measure' type='quantitative' />
            <column caption='UR group' datatype='string' name='[UR_group]' role='dimension' type='nominal' />
            <column caption='Income Quintile' datatype='string' datatype-customized='true' name='[income_quintile]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;1&quot;' value='1 – Most deprived' />
                <alias key='&quot;5&quot;' value='5 – Least deprived' />
              </aliases>
            </column>
            <column-instance column='[UR_group]' derivation='None' name='[none:UR_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[income_quintile]' derivation='None' name='[none:income_quintile:nk]' pivot='key' type='nominal' />
            <column caption='Pop Over15' datatype='integer' name='[pop_over15]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0992369569644544]' derivation='User' name='[usr:Calculation_0992369569644544:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <manual-sort column='[federated.11boon3048arjm1g1m2de1r9jgon].[none:UR_group:nk]' direction='ASC'>
            <dictionary>
              <bucket>&quot;Urban&quot;</bucket>
              <bucket>&quot;Small Towns&quot;</bucket>
              <bucket>&quot;Rural&quot;</bucket>
            </dictionary>
          </manual-sort>
          <filter class='categorical' column='[federated.11boon3048arjm1g1m2de1r9jgon].[none:income_quintile:nk]'>
            <groupfilter function='except' user:ui-domain='relevant' user:ui-enumeration='exclusive' user:ui-marker='enumerate'>
              <groupfilter function='level-members' level='[none:income_quintile:nk]' />
              <groupfilter function='member' level='[none:income_quintile:nk]' member='%null%' />
            </groupfilter>
          </filter>
          <slices>
            <column>[federated.11boon3048arjm1g1m2de1r9jgon].[none:income_quintile:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='cell'>
            <format attr='width' field='[federated.11boon3048arjm1g1m2de1r9jgon].[none:income_quintile:nk]' value='99' />
          </style-rule>
        </style>
        <panes>
