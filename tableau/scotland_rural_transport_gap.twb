  <worksheets>
    <worksheet name='Councils over 15 min'>
      <layout-options>
        <title>
          <formatted-text>
            <run><![CDATA[Share of residents more than 15 min from a GP by public transport<Sheet Name>]]></run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_data' name='federated.11boon3048arjm1g1m2de1r9jgon' />
          </datasources>
          <datasource-dependencies datasource='federated.11boon3048arjm1g1m2de1r9jgon'>
            <column caption='% over 15 min' datatype='real' default-format='p0.0%' name='[Calculation_0992369569644544]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([pop_over15]) / SUM([Total_population])' />
            </column>
            <column caption='Above Scotland average' datatype='boolean' name='[Calculation_0992369575350273]' role='measure' type='nominal'>
              <calculation class='tableau' formula='[Calculation_0992369569644544] &gt; 0.16' />
            </column>
            <column caption='Council area' datatype='string' name='[Council_area]' role='dimension' type='nominal' />
